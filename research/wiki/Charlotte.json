      "*": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\">Charlotte (샤를로트) <span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Characters\" src=\"https://static.wikia.nocookie.net/potionmaker/images/3/36/Characters.png/revision/latest/scale-to-width-down/20?cb=20150527022122\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"16\" class=\"mw-file-element\" data-image-name=\"Characters.png\" data-image-key=\"Characters.png\" data-relevant=\"0\" /></span></span></h2>\n\n<figure class=\"pi-item pi-image\" data-source=\"image\">\n\t<a href=\"https://static.wikia.nocookie.net/potionmaker/images/4/44/CharlottePortraitNormal.png/revision/latest?cb=20150613212422\" class=\"image image-thumbnail\" title=\"CharlottePortraitNormal\">\n\t\t<img src=\"https://static.wikia.nocookie.net/potionmaker/images/4/44/CharlottePortraitNormal.png/revision/latest/scale-to-width-down/268?cb=20150613212422\" srcset=\"https://static.wikia.nocookie.net/potionmaker/images/4/44/CharlottePortraitNormal.png/revision/latest/scale-to-width-down/268?cb=20150613212422 1x, https://static.wikia.nocookie.net/potionmaker/images/4/44/CharlottePortraitNormal.png/revision/latest?cb=20150613212422 2x\" class=\"pi-image-thumbnail\" data-relevant=\"1\" alt=\"CharlottePortraitNormal\" width=\"270\" height=\"251\" data-image-key=\"CharlottePortraitNormal.png\" data-image-name=\"CharlottePortraitNormal.png\" />\n\t\t\n\t</a>\n\t\n</figure>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"name\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Name</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Charlotte (샤를로트)</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data